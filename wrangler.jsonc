{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-07-10",
	// nodejs_compat is required: the SSR bundle pulls in Node builtins
	// (buffer/util via @spreadless-dex/sdk, crypto via stellar-wallets-kit),
	// which the Workers runtime only provides with this flag. Without it the
	// Worker fails startup validation on deploy — `wrangler deploy --dry-run`
	// does NOT catch this, only a real deploy or `wrangler`/workerd dev does.
	"compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
	"name": "spreadless-dex-frontend",
	// Our own entry: Astro's fetch handler plus the cron that checks price
	// alerts (src/worker.ts).
	"main": "./src/worker.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// Pinned explicitly so Workers Builds binds the existing namespace instead
	// of trying to auto-provision a fresh one on every deploy. Without an id
	// here, @astrojs/cloudflare's default KV-backed session support (see
	// createIntegration() in the adapter — it defaults to a Cloudflare KV
	// session driver whenever astro.config.mjs doesn't configure one) makes
	// the build attempt `Creating new KV Namespace "spreadless-dex-frontend-
	// session"` on every run, which fails with code 10014 once the namespace
	// already exists — it never checks for an existing one first.
	"kv_namespaces": [
		{ "binding": "SESSION", "id": "8826f4f448d645708b8314d3673c434d" }
	],
	// Price alerts: who wants to hear about which pool (migrations/). Create
	// with `npx wrangler d1 create spreadless-alerts` and put its id here.
	"d1_databases": [
		{ "binding": "ALERTS", "database_name": "spreadless-alerts", "database_id": "REPLACE_WITH_D1_ID", "migrations_dir": "migrations" }
	],
	// Same cadence as the market snapshot's 60 s TTL.
	"triggers": { "crons": ["* * * * *"] },
	"vars": {
		// The bot users open to receive alerts in Telegram (t.me/<name>).
		"TELEGRAM_BOT_USERNAME": ""
	},
	"observability": {
		"enabled": true
	}
}