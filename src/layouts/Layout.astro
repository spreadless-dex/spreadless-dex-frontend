---
import '../styles/global.css'
import WalletBridge from '../components/WalletBridge'
import { IS_MAINNET } from '../lib/stellar/config'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'Spreadless · Stablecoin AMM on Stellar',
  description = 'Swap stablecoins with near-zero slippage and earn yield with single-sided liquidity on Stellar.',
} = Astro.props
---

<!DOCTYPE html>
<html lang="en" class:list={[{ 'has-banner': IS_MAINNET }]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <!-- Blocking theme + mode script: runs before first paint to prevent flash -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('spreadless-theme')
          if (t === 'dark') document.documentElement.classList.add('dark')
          if (localStorage.getItem('spreadless-mode') === 'pro') document.documentElement.setAttribute('data-mode', 'pro')
        } catch (e) {}
      })()
    </script>
  </head>
  <body>
    <!-- Ambient canvas — fixed full-viewport, behind all content -->
    <div id="canvas" aria-hidden="true">
      <img id="canvas-light-desktop" src="/base_white.png"        alt="" />
      <img id="canvas-dark-desktop"  src="/base_black.png"        alt="" />
      <img id="canvas-light-mobile"  src="/base_white_mobile.png" alt="" />
      <img id="canvas-dark-mobile"   src="/base_black_mobile.png" alt="" />
    </div>

    <!-- Scrim — dims canvas so page content reads clearly above it -->
    <div id="scrim" aria-hidden="true"></div>

    <!-- Unaudited notice. Fixed above the header, which --banner-h pushes down
         (see global.css); every mainnet page carries it. -->
    {IS_MAINNET && (
      <div class="unaudited-banner" role="note">
        <strong>Unaudited.</strong>
        <span class="unaudited-banner-long">
          Spreadless runs on Stellar mainnet while its smart-contract audit is underway. Use it at your own risk.
        </span>
        <span class="unaudited-banner-short">Use at your own risk.</span>
        <a href="/docs/protocol/deployments">Details</a>
      </div>
    )}

    <!-- All page content sits above canvas + scrim -->
    <div id="content">
      <slot />
    </div>
    <!-- Wallet backends (Privy login + connect chooser). client:only: Privy is browser-only. -->
    <WalletBridge client:only="react" />
  </body>
</html>
