---
import Layout from "./Layout.astro";
import Header from "../components/Header";
import {
  DOCS_NAV,
  DOCS_FLAT,
  docHref,
  prevNext,
} from "../lib/docs-nav";
import type { MarkdownHeading } from "astro";

interface Props {
  title: string;
  description?: string;
  slug: string;
  headings?: MarkdownHeading[];
}

const { title, description, slug, headings = [] } = Astro.props;
const { prev, next } = prevNext(slug);
const current = DOCS_FLAT.find((p) => p.slug === slug);
const sectionTitle = current?.section ?? "Docs";

// On-this-page TOC: h2 + h3 only. Astro auto-assigns slug ids to headings.
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<Layout title={`${title} — Spreadless Docs`} description={description}>
  <Header client:load currentPage="docs" />

  <div class="docs-shell">
    {/* ── Left sidebar (lg+) ── */}
    <aside class="docs-sidebar" aria-label="Documentation">
      <nav>
        {
          DOCS_NAV.map((section) => (
            <div class="docs-sidebar-section">
              <p class="docs-sidebar-title">{section.title}</p>
              <ul>
                {section.pages.map((page) => (
                  <li>
                    <a
                      href={docHref(page.slug)}
                      class="docs-sidebar-link"
                      aria-current={page.slug === slug ? "page" : undefined}
                    >
                      {page.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </aside>

    {/* ── Article ── */}
    <main class="docs-main">
      {/* Mobile nav — native <details>, no JS */}
      <details class="docs-mobile-nav">
        <summary>
          <span>Documentation</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <polyline points="6 9 12 15 18 9" />
          </svg>
        </summary>
        <div class="docs-mobile-nav-body">
          {
            DOCS_NAV.map((section) => (
              <div class="docs-sidebar-section">
                <p class="docs-sidebar-title">{section.title}</p>
                <ul>
                  {section.pages.map((page) => (
                    <li>
                      <a
                        href={docHref(page.slug)}
                        class="docs-sidebar-link"
                        aria-current={page.slug === slug ? "page" : undefined}
                      >
                        {page.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </details>

      <article class="docs-article">
        <p class="docs-eyebrow">{sectionTitle}</p>
        <h1 class="docs-h1">{title}</h1>
        {description && <p class="docs-lede">{description}</p>}

        <div class="docs-prose">
          <slot />
        </div>

        <nav class="docs-prevnext" aria-label="Pagination">
          {
            prev ? (
              <a href={docHref(prev.slug)} class="docs-prevnext-link">
                <span class="docs-prevnext-dir">← Previous</span>
                <span class="docs-prevnext-label">{prev.label}</span>
              </a>
            ) : (
              <span />
            )
          }
          {
            next ? (
              <a href={docHref(next.slug)} class="docs-prevnext-link docs-prevnext-next">
                <span class="docs-prevnext-dir">Next →</span>
                <span class="docs-prevnext-label">{next.label}</span>
              </a>
            ) : (
              <span />
            )
          }
        </nav>
      </article>

      {/* ── On this page (xl+) ── */}
      {
        toc.length > 0 && (
          <aside class="docs-toc" aria-label="On this page">
            <p class="docs-toc-title">On this page</p>
            <ul>
              {toc.map((h) => (
                <li class={h.depth === 3 ? "docs-toc-sub" : ""}>
                  <a href={`#${h.slug}`} data-toc-link={h.slug}>
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }
    </main>
  </div>
</Layout>

<style>
  .docs-shell {
    max-width: 90rem;
    margin: 0 auto;
    padding-top: 4rem; /* fixed header */
    display: grid;
    grid-template-columns: 1fr;
  }

  /* ── Sidebar ── */
  .docs-sidebar {
    display: none;
  }

  @media (min-width: 1024px) {
    .docs-shell {
      grid-template-columns: 16rem minmax(0, 1fr);
      gap: 0;
    }
    .docs-sidebar {
      display: block;
      position: sticky;
      top: 4rem;
      align-self: start;
      height: calc(100vh - 4rem);
      overflow-y: auto;
      padding: 2.5rem 1.25rem 3rem 1.5rem;
      border-right: 1px solid var(--c-border);
    }
  }

  .docs-sidebar-section {
    margin-bottom: 1.5rem;
  }
  .docs-sidebar-title {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-text-faint);
    margin: 0 0 0.6rem;
    padding-left: 0.75rem;
  }
  .docs-sidebar-section ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
  }
  .docs-sidebar-link {
    display: block;
    padding: 0.4rem 0.75rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.3;
    color: var(--c-text-muted);
    text-decoration: none;
    transition: color 0.15s ease, background-color 0.15s ease;
  }
  .docs-sidebar-link:hover {
    color: var(--c-text);
    background-color: var(--c-surface-2);
  }
  .docs-sidebar-link[aria-current="page"] {
    color: var(--c-text);
    font-weight: 500;
    background-color: var(--c-surface-2);
  }

  /* ── Mobile nav ── */
  .docs-mobile-nav {
    margin: 1.5rem 1.5rem 0;
    border: 1px solid var(--c-border);
    border-radius: 0.75rem;
    background-color: color-mix(in srgb, var(--c-surface) 88%, transparent);
  }
  @media (min-width: 1024px) {
    .docs-mobile-nav {
      display: none;
    }
  }
  .docs-mobile-nav summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--c-text);
  }
  .docs-mobile-nav summary::-webkit-details-marker {
    display: none;
  }
  .docs-mobile-nav[open] summary svg {
    transform: rotate(180deg);
  }
  .docs-mobile-nav summary svg {
    transition: transform 0.2s ease;
    color: var(--c-text-muted);
  }
  .docs-mobile-nav-body {
    padding: 0.25rem 1rem 1rem;
    border-top: 1px solid var(--c-border);
    max-height: 60vh;
    overflow-y: auto;
  }

  /* ── Main / article ── */
  .docs-main {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 1280px) {
    .docs-main {
      grid-template-columns: minmax(0, 1fr) 14rem;
    }
  }

  .docs-article {
    min-width: 0;
    padding: 3rem 1.5rem 4rem;
    max-width: 46rem;
  }
  @media (min-width: 1024px) {
    .docs-article {
      padding: 3.5rem 3rem 5rem;
    }
  }

  .docs-eyebrow {
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--c-text-faint);
    margin: 0 0 0.9rem;
  }
  .docs-h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.08;
    color: var(--c-text);
    margin: 0 0 1rem;
    text-wrap: balance;
  }
  .docs-lede {
    font-size: 1.1rem;
    line-height: 1.6;
    font-weight: 300;
    color: var(--c-text-muted);
    margin: 0 0 1rem;
    max-width: 40ch;
  }

  /* ── Prose (slotted MDX) ── */
  .docs-prose {
    margin-top: 2.5rem;
    font-size: 0.975rem;
    line-height: 1.7;
    color: var(--c-text);
  }
  .docs-prose :global(> *:first-child) {
    margin-top: 0;
  }
  .docs-prose :global(h2) {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--c-text);
    margin: 3rem 0 1rem;
    padding-top: 0.5rem;
    scroll-margin-top: 5rem;
    border-top: 1px solid var(--c-border);
    padding-top: 2rem;
  }
  .docs-prose :global(h3) {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--c-text);
    margin: 2rem 0 0.75rem;
    scroll-margin-top: 5rem;
  }
  .docs-prose :global(p) {
    margin: 0 0 1.1rem;
    color: var(--c-text);
  }
  .docs-prose :global(a) {
    color: var(--c-text);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--c-border-2);
    transition: text-decoration-color 0.15s ease;
  }
  .docs-prose :global(a:hover) {
    text-decoration-color: var(--c-text);
  }
  .docs-prose :global(strong) {
    font-weight: 650;
  }
  .docs-prose :global(ul),
  .docs-prose :global(ol) {
    margin: 0 0 1.1rem;
    padding-left: 1.3rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .docs-prose :global(li) {
    padding-left: 0.2rem;
  }
  .docs-prose :global(li::marker) {
    color: var(--c-text-faint);
  }
  .docs-prose :global(code) {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.85em;
    background-color: var(--c-surface-2);
    border: 1px solid var(--c-border);
    padding: 0.1em 0.4em;
    border-radius: 0.35rem;
    color: var(--c-text);
  }
  .docs-prose :global(pre) {
    background-color: var(--c-surface-2) !important;
    border: 1px solid var(--c-border);
    border-radius: 0.75rem;
    padding: 1.1rem 1.25rem;
    overflow-x: auto;
    margin: 0 0 1.4rem;
    font-size: 0.85rem;
    line-height: 1.6;
  }
  .docs-prose :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    font-size: inherit;
  }
  .docs-prose :global(blockquote) {
    margin: 0 0 1.4rem;
    padding: 0.2rem 0 0.2rem 1.1rem;
    border-left: 2px solid var(--c-border-2);
    color: var(--c-text-muted);
  }
  .docs-prose :global(hr) {
    border: none;
    border-top: 1px solid var(--c-border);
    margin: 2.5rem 0;
  }
  .docs-prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 1.4rem;
    font-size: 0.875rem;
    display: block;
    overflow-x: auto;
  }
  .docs-prose :global(th) {
    text-align: left;
    font-weight: 600;
    color: var(--c-text-muted);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid var(--c-border-2);
    white-space: nowrap;
  }
  .docs-prose :global(td) {
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid var(--c-border);
    vertical-align: top;
  }
  .docs-prose :global(td code) {
    white-space: nowrap;
  }

  /* ── Prev / next ── */
  .docs-prevnext {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--c-border);
  }
  .docs-prevnext-link {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--c-border);
    border-radius: 0.75rem;
    text-decoration: none;
    background-color: color-mix(in srgb, var(--c-surface) 70%, transparent);
    transition: border-color 0.15s ease, transform 0.15s ease;
    max-width: 48%;
  }
  .docs-prevnext-link:hover {
    border-color: var(--c-border-2);
    transform: translateY(-2px);
  }
  .docs-prevnext-next {
    text-align: right;
    align-items: flex-end;
  }
  .docs-prevnext-dir {
    font-size: 0.75rem;
    color: var(--c-text-faint);
  }
  .docs-prevnext-label {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--c-text);
  }

  /* ── On this page ── */
  .docs-toc {
    display: none;
  }
  @media (min-width: 1280px) {
    .docs-toc {
      display: block;
      position: sticky;
      top: 4rem;
      align-self: start;
      max-height: calc(100vh - 4rem);
      overflow-y: auto;
      padding: 3.5rem 1.5rem 3rem 0.5rem;
    }
  }
  .docs-toc-title {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-text-faint);
    margin: 0 0 0.75rem;
  }
  .docs-toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    border-left: 1px solid var(--c-border);
  }
  .docs-toc a {
    display: block;
    padding: 0.25rem 0 0.25rem 0.9rem;
    margin-left: -1px;
    border-left: 1px solid transparent;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--c-text-muted);
    text-decoration: none;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .docs-toc a:hover {
    color: var(--c-text);
  }
  .docs-toc a.is-active {
    color: var(--c-text);
    border-left-color: var(--c-text);
  }
  .docs-toc-sub a {
    padding-left: 1.7rem;
    font-size: 0.78rem;
  }
</style>

{/* Scroll-spy for the On-this-page TOC. Guarded: no-op when TOC absent. */}
<script>
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>(".docs-toc a[data-toc-link]"),
  );
  if (links.length) {
    const bySlug = new Map(links.map((l) => [l.dataset.tocLink!, l]));
    const headings = links
      .map((l) => document.getElementById(l.dataset.tocLink!))
      .filter((el): el is HTMLElement => Boolean(el));

    let active: HTMLAnchorElement | null = null;
    const setActive = (slug: string | null) => {
      if (active) active.classList.remove("is-active");
      const link = slug ? bySlug.get(slug) ?? null : null;
      if (link) link.classList.add("is-active");
      active = link;
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible.length) setActive(visible[0].target.id);
      },
      { rootMargin: "-80px 0px -70% 0px", threshold: 0 },
    );
    headings.forEach((h) => observer.observe(h));
  }
</script>
