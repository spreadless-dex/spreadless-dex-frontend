---
// A boxed aside for docs prose. Monochrome by design — the "kind" changes the
// icon and a single-letter tone, never introduces a hue (the purple accent is
// reserved for yield figures elsewhere in the app).
interface Props {
  kind?: "note" | "tip" | "warning" | "math";
  title?: string;
}
const { kind = "note", title } = Astro.props;

const LABEL: Record<string, string> = {
  note: "Note",
  tip: "Tip",
  warning: "Heads up",
  math: "The math",
};
const heading = title ?? LABEL[kind];
---

<aside class:list={["callout", `callout-${kind}`]}>
  <div class="callout-icon" aria-hidden="true">
    {
      kind === "warning" ? (
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
          <line x1="12" y1="9" x2="12" y2="13" />
          <line x1="12" y1="17" x2="12.01" y2="17" />
        </svg>
      ) : kind === "tip" ? (
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.3 1 2.1h6c0-.8.4-1.6 1-2.1A7 7 0 0 0 12 2z" />
        </svg>
      ) : kind === "math" ? (
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="5" x2="5" y2="19" />
          <circle cx="6.5" cy="6.5" r="2.5" />
          <circle cx="17.5" cy="17.5" r="2.5" />
        </svg>
      ) : (
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10" />
          <line x1="12" y1="16" x2="12" y2="12" />
          <line x1="12" y1="8" x2="12.01" y2="8" />
        </svg>
      )
    }
  </div>
  <div class="callout-body">
    {heading && <p class="callout-title">{heading}</p>}
    <div class="callout-content"><slot /></div>
  </div>
</aside>

<style>
  .callout {
    display: flex;
    gap: 0.85rem;
    margin: 0 0 1.5rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--c-border);
    border-radius: 0.75rem;
    background-color: color-mix(in srgb, var(--c-surface) 75%, transparent);
  }
  .callout-warning {
    border-color: var(--c-border-2);
    border-left-width: 3px;
  }
  .callout-math {
    background-color: var(--c-surface-2);
  }
  .callout-icon {
    flex-shrink: 0;
    margin-top: 0.15rem;
    color: var(--c-text-muted);
  }
  .callout-warning .callout-icon {
    color: var(--c-text);
  }
  .callout-body {
    min-width: 0;
  }
  .callout-title {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-text-muted);
    margin: 0 0 0.3rem;
  }
  .callout-content :global(p) {
    margin: 0 0 0.6rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--c-text);
  }
  .callout-content :global(p:last-child) {
    margin-bottom: 0;
  }
  .callout-content :global(code) {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.82em;
    background-color: var(--c-surface);
    border: 1px solid var(--c-border);
    padding: 0.1em 0.35em;
    border-radius: 0.3rem;
  }
</style>
