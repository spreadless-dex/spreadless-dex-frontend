---
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header'
import Faucet from '../components/Faucet'
import { HAS_FAUCET } from '../lib/stellar/config'

// Mainnet has nothing to mint; an old link lands on the swap page instead.
if (!HAS_FAUCET) return Astro.redirect('/swap')
---

<Layout title="Faucet · Spreadless">
  <Header client:load currentPage="faucet" />
  <main class="min-h-screen flex items-start justify-center px-6 pt-28 pb-16">
    <Faucet client:load />
  </main>
</Layout>
