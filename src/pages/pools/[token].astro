---
import Layout from '../../layouts/Layout.astro'
import Header from '../../components/Header'
import PoolDetailPage from '../../components/PoolDetailPage'
import { POOL_TOKENS } from '../../lib/stellar/config'

export function getStaticPaths() {
  // One static page per token of the live pool; slug is the lowercased symbol
  // (usdx, pyusd, susd, susdc). The live on-chain data is fetched client-side
  // in the island. Deliberately POOL_TOKENS and not TOKENS: the catalog's
  // tokens sit in no pool, so a page each would only render the "not in the
  // pool" empty state.
  return POOL_TOKENS.map((t) => ({
    params: { token: t.symbol.toLowerCase() },
    props: { symbol: t.symbol },
  }))
}

const { symbol } = Astro.props
---

<Layout title={`${symbol} pool · Spreadless`}>
  <Header client:load currentPage="pools" />
  <div class="min-h-screen pt-16">
    <PoolDetailPage client:load symbol={symbol} />
  </div>
</Layout>
