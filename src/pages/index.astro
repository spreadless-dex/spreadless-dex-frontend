---
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header'
import SwapWidget from '../components/SwapWidget'
---

<Layout title="Spreadless — Stablecoin AMM on Stellar">
  <Header client:load currentPage="home" />

  <!-- Hero -->
  <section class="min-h-screen flex flex-col justify-center pt-16 px-6">
    <div class="max-w-7xl mx-auto w-full flex items-center gap-16 py-24 md:py-32">

      <!-- Left: text content -->
      <div class="flex-1 min-w-0">

        <!-- Solid black badge -->
        <!-- <div
          class="inline-flex items-center gap-2 mb-8 px-4 py-2 rounded-full text-xs font-bold uppercase tracking-widest animate-fade-up"
          style="background-color: var(--c-text); color: var(--c-surface); animation-delay: 0s;"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-green-400"></span>
          Live on Stellar
        </div> -->

        <h1
          class="text-[clamp(2.8rem,5vw,5rem)] leading-[1.02] tracking-tighter mb-6 max-w-xl animate-fade-up"
          style="font-weight: 900; color: var(--c-text); animation-delay: 0.08s;"
        >
          Stablecoin swaps,<br />
          <span style="color: var(--c-text-muted);">finally efficient.</span>
        </h1>

        <p
          class="text-base md:text-lg max-w-md mb-12 leading-relaxed animate-fade-up"
          style="color: var(--c-text-muted); animation-delay: 0.16s;"
        >
          Near-zero slippage on stablecoin trades. Single-sided liquidity so you earn
          without managing pairs.
        </p>

        <div class="flex items-center gap-4 mb-20 animate-fade-up" style="animation-delay: 0.24s;">
          <a
            href="/pools"
            class="inline-flex items-center gap-2 px-6 py-3 text-sm font-bold rounded-xl active:scale-[0.99] transition-all"
            style="background-color: var(--c-cta-bg); color: var(--c-cta-text);"
          >
            Start Earning
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
              <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
            </svg>
          </a>
          <a
            href="/swap"
            class="inline-flex items-center px-5 py-3 text-sm font-medium transition-all"
            style="color: var(--c-text-muted);"
          >
            Exchange Currencies →
          </a>
        </div>

        <div
          class="flex items-center gap-10 pt-8 animate-fade-up"
          style="border-top: 1px solid var(--c-border); animation-delay: 0.32s;"
        >
          {[
            { val: '$31.5M', label: 'Total Value Locked' },
            { val: '$5.8M',  label: '24h Volume' },
            { val: '8.42%', label: 'Top APY' },
          ].map(({ val, label }) => (
            <div>
              <p class="text-2xl md:text-3xl font-black" style="color: var(--c-text);">{val}</p>
              <p class="text-[11px] uppercase tracking-wider mt-1" style="color: var(--c-text-faint);">{label}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: swap widget -->
      <div class="hidden lg:flex flex-shrink-0">
        <SwapWidget client:load />
      </div>

    </div>
  </section>

  <!-- How it works -->
  <section id="how-it-works" class="px-6 py-28" style="border-top: 1px solid var(--c-border);">
    <div class="max-w-7xl mx-auto">
      <p class="text-[11px] uppercase tracking-[0.2em] mb-4" style="color: var(--c-text-faint);">How it works</p>
      <h2 class="text-4xl md:text-5xl font-bold mb-16 max-w-lg leading-tight" style="color: var(--c-text);">
        Capital efficiency,<br />by design.
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {[
          {
            title: 'Minimal Slippage',
            body: 'The StableSwap invariant — pioneered by Curve Finance — enables near 1:1 stablecoin trades with virtually zero price impact even on large orders.',
            icon: '<path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>',
          },
          {
            title: 'Single-sided Liquidity',
            body: 'Deposit one token, not a pair. No need to split your capital or manage multiple positions. Simpler entry, more capital efficient, less risk.',
            icon: '<circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="12" x2="15" y2="14"/>',
          },
          {
            title: 'Built on Soroban',
            body: "Stellar's smart contract platform delivers fast finality and near-zero transaction fees. Your yield isn't eaten by gas — it goes to you.",
            icon: '<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>',
          },
        ].map(({ title, body, icon }) => (
          <div
            class="p-6 rounded-2xl transition-all duration-300"
            style="background-color: var(--c-surface); border: 1px solid var(--c-border); box-shadow: var(--c-card-shadow);"
          >
            <div
              class="w-10 h-10 rounded-xl flex items-center justify-center mb-6"
              style="border: 1px solid var(--c-border); background-color: var(--c-surface-2); color: var(--c-text-muted);"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={icon} />
            </div>
            <h3 class="font-semibold mb-3 text-base" style="color: var(--c-text);">{title}</h3>
            <p class="text-sm leading-relaxed" style="color: var(--c-text-muted);">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Understanding the curve -->
  <section class="px-6 py-28" style="border-top: 1px solid var(--c-border);">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div>
        <p class="text-[11px] uppercase tracking-[0.2em] mb-4" style="color: var(--c-text-faint);">The math, briefly</p>
        <h2 class="text-4xl md:text-5xl font-bold mb-6 leading-tight" style="color: var(--c-text);">
          Understanding<br />the curve.
        </h2>
        <p class="text-base leading-relaxed mb-8 max-w-lg" style="color: var(--c-text-muted);">
          Spreadless prices trades with the StableSwap invariant, a curve designed
          for assets that are expected to trade near the same value — like
          stablecoins. Instead of the constant-product curve regular AMMs use
          (which gets expensive fast as trade size grows), StableSwap stays flat
          near the 1:1 price and only curves sharply once a pool's balance gets
          skewed.
        </p>
        <a
          href="#"
          aria-disabled="true"
          class="inline-flex items-center gap-2 px-5 py-3 text-sm font-medium rounded-xl select-none cursor-not-allowed"
          style="border: 1px solid var(--c-border); color: var(--c-text-faint);"
          onclick="return false"
        >
          Read the Docs
          <span class="text-[10px] px-1.5 py-0.5 rounded uppercase tracking-wider" style="border: 1px solid var(--c-border-2);">Soon</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {[
          {
            title: 'Amplification factor (A)',
            body: 'A tunable coefficient that controls how "flat" the curve is. A higher A means trades near the peg move the price less — tighter, more efficient pricing for correlated assets.',
          },
          {
            title: 'Why it lowers slippage',
            body: 'Because the curve stays flat near 1:1, swapping one stablecoin for another moves the effective price only slightly, even for larger orders — as long as the pool stays reasonably balanced.',
          },
          {
            title: 'What happens off-peg',
            body: 'If a pool tilts heavily toward one asset, the curve steepens and slippage increases — the same mechanism that protects LPs also discourages draining an imbalanced pool.',
          },
          {
            title: 'Single-sided by design',
            body: "Because the invariant already assumes correlated assets, you can deposit just one token — the pool handles balancing across all the others.",
          },
        ].map(({ title, body }) => (
          <div
            class="p-5 rounded-2xl"
            style="background-color: var(--c-surface); border: 1px solid var(--c-border); box-shadow: var(--c-card-shadow);"
          >
            <h3 class="font-semibold mb-2 text-sm" style="color: var(--c-text);">{title}</h3>
            <p class="text-xs leading-relaxed" style="color: var(--c-text-muted);">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="px-6 py-32 text-center" style="border-top: 1px solid var(--c-border);">
    <div class="max-w-2xl mx-auto">
      <p class="text-[11px] uppercase tracking-[0.2em] mb-6" style="color: var(--c-text-faint);">Get started</p>
      <h2 class="text-5xl md:text-6xl font-bold mb-5 leading-tight" style="color: var(--c-text);">Ready to earn?</h2>
      <p class="text-lg mb-10 font-light" style="color: var(--c-text-muted);">
        No pairs. No complexity. Just deposit and earn.
      </p>
      <a
        href="/pools"
        class="inline-flex items-center gap-2 px-8 py-4 font-semibold rounded-xl active:scale-[0.99] transition-all text-sm"
        style="background-color: var(--c-cta-bg); color: var(--c-cta-text);"
      >
        View Pools
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>
    </div>
  </section>

  <!-- Footer -->
  <footer class="px-6 py-8" style="border-top: 1px solid var(--c-border);">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <span class="text-sm font-semibold" style="color: var(--c-text-faint);">Spreadless</span>
      <div class="flex items-center gap-4 text-xs" style="color: var(--c-text-faint);">
        <span>Built on Stellar</span>
        <span>·</span>
        <span>© 2026</span>
      </div>
    </div>
  </footer>
</Layout>
