---
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header'
import SwapWidget from '../components/SwapWidget'
---

<Layout title="Spreadless — Stablecoin AMM on Stellar">
  <Header client:load currentPage="home" />

  <!-- Hero -->
  <section class="min-h-screen flex flex-col justify-center pt-16 px-6 overflow-hidden">
    <div class="max-w-7xl mx-auto w-full py-24 md:py-32 flex items-center gap-12">

      <!-- Left: text content -->
      <div class="flex-1 min-w-0">
        <h1
          class="text-[clamp(2.8rem,6vw,5.5rem)] font-bold tracking-tight leading-[1.05] mb-6 text-white max-w-2xl animate-fade-up"
          style="animation-delay: 0.05s;"
        >
          Stablecoin swaps,<br />
          <span class="text-white/30">finally efficient.</span>
        </h1>

        <p
          class="text-lg md:text-xl text-white/45 max-w-lg mb-12 font-light leading-relaxed animate-fade-up"
          style="animation-delay: 0.15s;"
        >
          Spreadless brings StableSwap to Stellar. Near-zero slippage on stablecoin trades,
          and single-sided liquidity so you can earn without the complexity.
        </p>

        <div
          class="flex items-center gap-4 mb-20 animate-fade-up"
          style="animation-delay: 0.25s;"
        >
          <a
            href="/pools"
            class="inline-flex items-center gap-2 px-6 py-3 bg-white text-black text-sm font-semibold rounded-xl hover:bg-white/90 active:scale-[0.99] transition-all"
          >
            Start Earning
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
              <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
            </svg>
          </a>
          <a
            href="#how-it-works"
            class="inline-flex items-center gap-2 px-6 py-3 border border-white/[0.12] text-white/65 text-sm rounded-xl hover:border-white/25 hover:text-white transition-all"
          >
            Learn more
          </a>
        </div>

        <div
          class="grid grid-cols-3 gap-8 pt-8 border-t border-white/[0.06] max-w-lg animate-fade-up"
          style="animation-delay: 0.35s;"
        >
          <div>
            <p class="text-2xl md:text-3xl font-bold text-white">$31.5M</p>
            <p class="text-xs text-white/30 mt-1 uppercase tracking-wider">Total Value Locked</p>
          </div>
          <div>
            <p class="text-2xl md:text-3xl font-bold text-white">$5.8M</p>
            <p class="text-xs text-white/30 mt-1 uppercase tracking-wider">24h Volume</p>
          </div>
          <div>
            <p class="text-2xl md:text-3xl font-bold text-white">5</p>
            <p class="text-xs text-white/30 mt-1 uppercase tracking-wider">Active Pools</p>
          </div>
        </div>
      </div>

      <!-- Right: swap widget -->
      <div class="hidden lg:flex flex-shrink-0 items-center justify-center">
        <SwapWidget client:load />
      </div>

    </div>
  </section>

  <!-- How it works -->
  <section id="how-it-works" class="px-6 py-28 border-t border-white/[0.04]">
    <div class="max-w-7xl mx-auto">
      <p class="text-[11px] text-white/25 uppercase tracking-[0.2em] mb-4">How it works</p>
      <h2 class="text-4xl md:text-5xl font-bold text-white mb-16 max-w-lg leading-tight">
        Capital efficiency,<br />by design.
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="p-6 border border-white/[0.06] rounded-2xl bg-[#0d0d0d] hover:border-white/[0.1] transition-colors duration-300">
          <div class="w-10 h-10 rounded-xl border border-white/[0.08] bg-white/[0.03] flex items-center justify-center mb-6 text-white/50">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2L2 7l10 5 10-5-10-5z"/>
              <path d="M2 17l10 5 10-5"/>
              <path d="M2 12l10 5 10-5"/>
            </svg>
          </div>
          <h3 class="text-white font-semibold mb-3 text-base">Minimal Slippage</h3>
          <p class="text-white/38 text-sm leading-relaxed">
            The StableSwap invariant — pioneered by Curve Finance — enables near 1:1 stablecoin trades with virtually zero price impact even on large orders.
          </p>
        </div>

        <div class="p-6 border border-white/[0.06] rounded-2xl bg-[#0d0d0d] hover:border-white/[0.1] transition-colors duration-300">
          <div class="w-10 h-10 rounded-xl border border-white/[0.08] bg-white/[0.03] flex items-center justify-center mb-6 text-white/50">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <line x1="12" y1="8" x2="12" y2="12"/>
              <line x1="12" y1="12" x2="15" y2="14"/>
            </svg>
          </div>
          <h3 class="text-white font-semibold mb-3 text-base">Single-sided Liquidity</h3>
          <p class="text-white/38 text-sm leading-relaxed">
            Deposit one token, not a pair. No need to split your capital or manage multiple positions. Simpler entry, more capital efficient, less risk.
          </p>
        </div>

        <div class="p-6 border border-white/[0.06] rounded-2xl bg-[#0d0d0d] hover:border-white/[0.1] transition-colors duration-300">
          <div class="w-10 h-10 rounded-xl border border-white/[0.08] bg-white/[0.03] flex items-center justify-center mb-6 text-white/50">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
            </svg>
          </div>
          <h3 class="text-white font-semibold mb-3 text-base">Built on Soroban</h3>
          <p class="text-white/38 text-sm leading-relaxed">
            Stellar's smart contract platform delivers fast finality and near-zero transaction fees. Your yield isn't eaten by gas — it goes to you.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="px-6 py-32 text-center border-t border-white/[0.04]">
    <div class="max-w-2xl mx-auto">
      <p class="text-[11px] text-white/25 uppercase tracking-[0.2em] mb-6">Get started</p>
      <h2 class="text-5xl md:text-6xl font-bold text-white mb-5 leading-tight">Ready to earn?</h2>
      <p class="text-white/38 text-lg mb-10 font-light">
        No pairs. No complexity. Just deposit and earn.
      </p>
      <a
        href="/pools"
        class="inline-flex items-center gap-2 px-8 py-4 bg-white text-black font-semibold rounded-xl hover:bg-white/90 active:scale-[0.99] transition-all text-sm"
      >
        View Pools
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>
    </div>
  </section>

  <!-- Footer -->
  <footer class="border-t border-white/[0.04] px-6 py-8">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <span class="text-white/20 text-sm font-semibold">Spreadless</span>
      <div class="flex items-center gap-4 text-white/20 text-xs">
        <span>Built on Stellar</span>
        <span class="text-white/10">·</span>
        <span>© 2025</span>
      </div>
    </div>
  </footer>
</Layout>
